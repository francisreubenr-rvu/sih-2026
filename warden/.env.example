# DHRISTI Warden configuration. Copy to .env and fill in.
# .env is gitignored and must never be committed.

# Groq API key for the cloud planning stage. Get one at console.groq.com/keys.
# Without it the Warden still starts, /health reports groqConfigured false, and
# /plan returns a clear error instead of a stack trace.
GROQ_API_KEY=

# Optional. Defaults shown.
# WARDEN_PORT=8756
# HF_HOME=/Volumes/1TB SSD/LM/hub
# OLLAMA_HOST=http://127.0.0.1:11434
# GROQ_MODEL_CHAIN=llama-3.3-70b-versatile,openai/gpt-oss-20b,llama-3.1-8b-instant
