# DHRISTI Warden configuration. Copy to .env and fill in.
# .env is gitignored and must never be committed.

# POST /plan planner. Default (unset) is Groq in the cloud, on already-tokenized
# text behind the egress guard (v5, 29 September 2026). Set ollama for offline
# local planning; a down Ollama never falls through to Groq.
# WARDEN_PLANNER=ollama

# Required on the default Groq path. Get a key at console.groq.com/keys.
# Never paste a key into a chat or a tracked file.
GROQ_API_KEY=

# Optional decision-model fast path in front of the planner (warden/fastpath.py).
# Unset = off. jev = TypeSafe Jev (cloud, needs JEV_API_KEY; skipped when
# WARDEN_PLANNER=ollama). laya = Laya on this machine (pip install laya; the
# first load downloads the 0.8 GB English checkpoint). It defers to the planner on any step it
# cannot answer with confidence at or above the threshold.
# WARDEN_FAST_PATH=laya
# WARDEN_FAST_PATH_MIN_CONFIDENCE=0.9
# JEV_API_KEY=
# WARDEN_LAYA_MODEL=/path/to/fine-tuned-checkpoint
# WARDEN_LAYA_DEVICE=cpu

# Optional. Defaults shown. OLLAMA_HOST must stay on 127.0.0.1, localhost, or ::1.
# Do not point WARDEN_OLLAMA_MODEL at a tag ending in :cloud.
# WARDEN_PORT=8756
# HF_HOME=/Volumes/1TB SSD/LM/hub
# OLLAMA_HOST=http://127.0.0.1:11434
# WARDEN_OLLAMA_MODEL=qwythos-9b:latest
# GROQ_MODEL_CHAIN=qwen/qwen3.8-27b,openai/gpt-oss-20b,openai/gpt-oss-120b

# Required. Pairing between the extension and this Warden (pairing.py). Without it every POST is
# refused. Make one, put it here, and paste the same value into the extension's Settings > Pairing
# code. Every POST must carry a request proof, every response carries X-Dhristi-Proof, and the
# secret itself never crosses the wire. At least 32 characters.
#   python pairing.py new
WARDEN_PAIRING_SECRET=

# Scripted harnesses and the test suite only: accept unsigned requests when no secret is set.
# The extension refuses such a Warden regardless, so this never applies to real use.
# WARDEN_PAIRING_DISABLED=1
