# DHRISTI Warden configuration. Copy to .env and fill in.
# .env is gitignored and must never be committed.

# POST /plan planner. Default is local Ollama on loopback. Leave unset.
# Groq is not the offline path. Set groq only to opt into that cloud planner.
# WARDEN_PLANNER=ollama

# Optional. Used only when WARDEN_PLANNER=groq. The default Ollama path never
# reads this, and a down Ollama does not fall through to Groq.
# Get a key at console.groq.com/keys. Never paste a key into a chat or a tracked file.
GROQ_API_KEY=

# Optional. Defaults shown. OLLAMA_HOST must stay on 127.0.0.1, localhost, or ::1.
# Do not point WARDEN_OLLAMA_MODEL at a tag ending in :cloud.
# WARDEN_PORT=8756
# HF_HOME=/Volumes/1TB SSD/LM/hub
# OLLAMA_HOST=http://127.0.0.1:11434
# WARDEN_OLLAMA_MODEL=qwythos-9b:latest
# GROQ_MODEL_CHAIN=openai/gpt-oss-20b,openai/gpt-oss-120b
