# Local defaults require no paid provider. First: ollama serve; ollama pull qwen2.5:7b-instruct
PORT=9041
HOST=127.0.0.1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
PUBLIC_ORIGIN=http://127.0.0.1:9041
# For extension pairing list the exact installed chrome-extension:// or moz-extension:// origin.
ALLOWED_ORIGINS=
# Public deployment requires a 24+ character secret provided via the hosting environment.
# SIGHTLINE_TOKEN=
