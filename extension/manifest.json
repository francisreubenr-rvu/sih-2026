{
  "manifest_version": 3,
  "name": "DHRISTI",
  "short_name": "DHRISTI",
  "version": "0.4.0",
  "description": "Local PII redaction via the Warden. The browser never calls a cloud model directly; the Warden relays sanitized planning requests.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:8756/*",
    "http://127.0.0.1:7860/*",
    "http://localhost:7860/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "DHRISTI"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["utils/redactor.js", "utils/op-tier.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
