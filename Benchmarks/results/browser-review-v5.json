 "fixed_in_this_change": [
  {
   "surface": "website",
   "finding": "Horizontal scroll at 320 px (content 354 px wide). The list item 'Placeholders such as EMAIL#1 instead of real values' is a flex container, so its text, the <code> and the rest of the text became three flex items that cannot wrap into one another, and the 'Sent to the cloud planner' box could not shrink below about 338 px.",
   "fix": "Website/index.html: the item's content is wrapped in one <span>. No CSS change.",
   "after": "320 px: scrollWidth 320, no clipped text, no off-screen controls"
  }
 ],
 "known_limitations": [
  {
   "surface": "prototype-popup",
   "finding": "At 320 and 390 px the popup scrolls sideways by the width of the vertical scrollbar: popup.css sets body{width:400px;max-width:100vw}, and 100vw includes the scrollbar.",
   "why_not_fixed": "Chrome sizes an extension popup from its content, so the popup is never viewed narrower than 400 px; switching to percentage widths is a known way to collapse a popup to near zero, and the real toolbar popup cannot be checked from this container. Prototype/extension is the measurement/demo surface, not the shipping v5 extension (the side panel, which passes).",
   "status": "open, documented"
  }
