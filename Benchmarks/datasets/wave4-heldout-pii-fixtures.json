{
  "name": "wave4-heldout-pii-fixtures",
  "version": "v01",
  "created": "2026-09-14",
  "scope": "Synthetic authored fixtures held out from unit-test inline cases. Expands Wave2 set with additional layout/adversarial cases. Not WebPII re-score, not real user screens, not official rubric saturation.",
  "inherits": "Benchmarks/datasets/wave2-heldout-pii-fixtures.json",
  "protocol": {
    "iouThreshold": 0.5,
    "scoring": "scoreRedactionPrecision + scoreVisualContext + scorePiiDetection from Prototype/shared",
    "status_label": "held_out_synthetic_fixture"
  },
  "cases": [
    {
      "id": "eo-desk-selective",
      "description": "Earth-observation style desk: face + private field + three allow-listed controls",
      "width": 320, "height": 200,
      "groundTruthPii": [
        { "kind": "face", "rect": { "x": 16, "y": 16, "width": 48, "height": 48 } },
        { "kind": "field", "rect": { "x": 80, "y": 140, "width": 120, "height": 24 } }
      ],
      "detectorRegions": [
        { "kind": "face", "rect": { "x": 14, "y": 14, "width": 52, "height": 52 } },
        { "kind": "field", "rect": { "x": 78, "y": 138, "width": 124, "height": 28 } }
      ],
      "expectedControls": [
        { "role": "button", "label": "Pending" },
        { "role": "button", "label": "Review" },
        { "role": "button", "label": "Next" }
      ],
      "observedControls": [
        { "role": "button", "label": "Pending" },
        { "role": "button", "label": "Review" },
        { "role": "button", "label": "Next" }
      ]
    },
    {
