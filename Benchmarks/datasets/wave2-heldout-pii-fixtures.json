{
  "name": "wave2-heldout-pii-fixtures",
  "version": "v01",
  "created": "2026-09-14",
  "scope": "Synthetic authored fixtures held out from unit-test inline cases. Not WebPII, not real user screens, not official rubric saturation.",
  "protocol": {
    "iouThreshold": 0.5,
    "scoring": "scoreRedactionPrecision + scoreVisualContext + scorePiiDetection from Prototype/shared",
    "status_label": "held_out_synthetic_fixture"
  },
  "cases": [
    {
      "id": "eo-desk-selective",
      "description": "Earth-observation style desk: face + private field + three allow-listed controls",
      "width": 320,
      "height": 200,
      "groundTruthPii": [
        { "kind": "face", "rect": { "x": 16, "y": 16, "width": 48, "height": 48 } },
        { "kind": "field", "rect": { "x": 80, "y": 140, "width": 120, "height": 24 } }
      ],
      "detectorRegions": [
        { "kind": "face", "rect": { "x": 14, "y": 14, "width": 52, "height": 52 } },
        { "kind": "field", "rect": { "x": 78, "y": 138, "width": 124, "height": 28 } }
      ],
      "expectedControls": [
        { "role": "button", "label": "Pending" },
        { "role": "button", "label": "Review" },
        { "role": "button", "label": "Next" }
      ],
      "observedControls": [
        { "role": "button", "label": "Pending" },
        { "role": "button", "label": "Review" },
        { "role": "button", "label": "Next" }
      ]
    },
    {
      "id": "password-adjacent-layout",
      "description": "Password field redacted; surrounding Cancel/Help controls must stay useful",
      "width": 280,
      "height": 160,
      "groundTruthPii": [
        { "kind": "password", "rect": { "x": 40, "y": 60, "width": 160, "height": 28 } }
      ],
      "detectorRegions": [
        { "kind": "password", "rect": { "x": 38, "y": 58, "width": 164, "height": 32 } }
      ],
      "expectedControls": [
        { "role": "button", "label": "Cancel" },
        { "role": "button", "label": "Help" }
      ],
      "observedControls": [
        { "role": "button", "label": "Cancel" },
        { "role": "button", "label": "Help" }
      ]
    },
    {
      "id": "indic-telemetry-boxes",
      "description": "Synthetic Aadhaar/PAN field boxes; detector supplies field kinds only (regex telemetry is separate)",
      "width": 360,
      "height": 180,
      "groundTruthPii": [
        { "kind": "field", "rect": { "x": 20, "y": 40, "width": 140, "height": 22 } },
        { "kind": "field", "rect": { "x": 20, "y": 80, "width": 100, "height": 22 } }
      ],
      "detectorRegions": [
        { "kind": "field", "rect": { "x": 18, "y": 38, "width": 144, "height": 26 } },
        { "kind": "field", "rect": { "x": 18, "y": 78, "width": 104, "height": 26 } }
      ],
      "expectedControls": [
        { "role": "button", "label": "Next" },
        { "role": "button", "label": "Back" }
      ],
      "observedControls": [
        { "role": "button", "label": "Next" },
        { "role": "button", "label": "Back" }
      ]
    },
    {
      "id": "missed-face-under-redaction",
      "description": "Detector miss: ground-truth face present, zero redaction predictions — privacy fail on coverage",
      "width": 200,
      "height": 200,
      "groundTruthPii": [
        { "kind": "face", "rect": { "x": 70, "y": 70, "width": 40, "height": 40 } }
      ],
      "detectorRegions": [],
      "expectedControls": [
        { "role": "button", "label": "Details" }
      ],
      "observedControls": [
        { "role": "button", "label": "Details" }
      ]
    },
    {
      "id": "full-image-over-redaction",
      "description": "Historical failure mode: full-frame mask covers PII but destroys utility",
      "width": 200,
      "height": 200,
      "groundTruthPii": [
        { "kind": "face", "rect": { "x": 20, "y": 20, "width": 40, "height": 40 } }
      ],
      "detectorRegions": [
        { "kind": "private", "rect": { "x": 0, "y": 0, "width": 200, "height": 200 } }
      ],
      "expectedControls": [
        { "role": "button", "label": "Pending" },
        { "role": "button", "label": "Next" }
      ],
      "observedControls": []
    },
    {
      "id": "partial-control-recall",
      "description": "Selective redaction ok; visual utility incomplete (one control missed)",
      "width": 300,
      "height": 180,
      "groundTruthPii": [
        { "kind": "media", "rect": { "x": 10, "y": 10, "width": 60, "height": 60 } }
      ],
      "detectorRegions": [
        { "kind": "media", "rect": { "x": 8, "y": 8, "width": 64, "height": 64 } }
      ],
      "expectedControls": [
        { "role": "button", "label": "Pending" },
        { "role": "button", "label": "Completed" },
        { "role": "button", "label": "Review" }
      ],
      "observedControls": [
        { "role": "button", "label": "Pending" },
        { "role": "button", "label": "Review" }
      ]
    }
  ]
}
